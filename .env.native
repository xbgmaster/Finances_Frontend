# ============================================================
#  Backend that the APK talks to.
#  Switch local <-> Render by (un)commenting ONE VITE_API_URL
#  below, then rebuild the APK from Finances_APK:
#      npm run apk:debug
# ============================================================

# --- Render (production) --- DEFAULT
VITE_API_URL=https://finances-backend-7njx.onrender.com/api

# --- Local backend on your PC, from a PHYSICAL phone ---
# Use your PC's LAN IP (run `ipconfig` -> IPv4), NOT "localhost".
# Phone and PC must be on the same Wi-Fi. The backend must listen on
# 0.0.0.0:5143 and allow this origin (CORS). HTTP works only on debug APKs.
# VITE_API_URL=http://192.168.1.100:5143/api

# --- Local backend from the Android EMULATOR ---
# 10.0.2.2 is the emulator's alias for your PC's localhost.
# VITE_API_URL=http://10.0.2.2:5143/api

# Native-shell flag used by Capacitor (HashRouter, status bar, splash).
# Keep this as-is for the APK build.
VITE_NATIVE=true
